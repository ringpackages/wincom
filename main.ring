func main
	C_LINESIZE = 80
	? copy("=",C_LINESIZE)
	? "WinCOM Package"
	? copy("=",C_LINESIZE)
	? "Windows COM (Component Object Model) for the Ring programming language"
	? "Use ADO, ADOX, Scripting, WScript, WMI, Microsoft Office, ... from Ring"
	? "Includes samples that use ADO with Microsoft Access databases"
	? "See the folder : ring/extensions/wincom"
	? "See the folder : ring/samples/UsingWinCOM"
	? copy("=",C_LINESIZE)
