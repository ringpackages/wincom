# Read the constants (enumerations) of a type library using com_constants()
# Then generate a Ring file that defines them
# Usage: ring test26_generate_constants.ring [ProgID] [OutputFile]
# Example: ring test26_generate_constants.ring Excel.Application excelconstants.ring

load "wincom.ring"

func main
	cProgID = "ADODB.Connection"
	cOutput = "adoconstants.ring"
	aArgs = sysargv
	if len(aArgs) >= 3
		cProgID = aArgs[3]
	ok
	if len(aArgs) >= 4
		cOutput = aArgs[4]
	ok
	if ! com_progidexists(cProgID)
		? "The ProgID is not registered: " + cProgID
		return
	ok

	# [cEnumeration, cName, vValue]
	aConstants = com_constants(com_createobject(cProgID))
	? "ProgID    : " + cProgID
	? "Constants : " + len(aConstants)

	# The enumerations and the number of constants in each one
	aGroups = []
	for aConstant in aConstants
		nPos = find(aGroups, aConstant[1], 1)
		if nPos = 0
			aGroups + [aConstant[1], 1]
		else
			aGroups[nPos][2]++
		ok
	next
	? "Groups    : " + len(aGroups)
	nCount = min(len(aGroups), 8)
	for nIndex = 1 to nCount
		? "	" + aGroups[nIndex][1] + " (" + aGroups[nIndex][2] + ")"
	next
	if len(aGroups) > nCount
		? "	..."
	ok

	# Generate the Ring file (Names are not case sensitive in Ring, so we skip the repeated names)
	cCode = "# Constants of " + cProgID + " (Generated by test26_generate_constants.ring)" + nl
	cGroup = ""
	aNames = []
	for aConstant in aConstants
		if find(aNames, lower(aConstant[2])) > 0
			loop
		ok
		aNames + lower(aConstant[2])
		if aConstant[1] != cGroup
			cGroup = aConstant[1]
			cCode += nl + "# " + cGroup + nl
		ok
		if isNumber(aConstant[3])
			cCode += aConstant[2] + " = " + aConstant[3] + nl
		else
			cCode += aConstant[2] + ' = "' + aConstant[3] + '"' + nl
		ok
	next
	write(cOutput, cCode)
	? nl + "Generated: " + cOutput + " (" + len(aNames) + " constants)"

	# Use the generated file
	eval(read(cOutput))
	? nl + "Using the generated constants:"
	if cProgID = "ADODB.Connection"
		? "	adOpenStatic   = " + adOpenStatic
		? "	adStatusCancel = " + adStatusCancel
	else
		? "	" + aConstants[1][2] + " = " + eval("return " + aConstants[1][2])
	ok
